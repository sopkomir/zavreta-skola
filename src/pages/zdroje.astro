---
import zdroje from "../data/zdroje.json";

const kategorie = [...new Set(zdroje.map((z) => z.category).filter(Boolean))].sort();
const typy = [...new Set(zdroje.map((z) => z.type).filter(Boolean))].sort();
---

<html lang="sk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Zdroje | Zavretá škola</title>
    <style>
      body { margin: 0; font-family: system-ui, sans-serif; background: #f7f8f5; color: #17202a; }
      main { width: min(1180px, calc(100% - 32px)); margin: 0 auto; padding: 40px 0; }
      h1 { margin: 0 0 12px; font-size: clamp(2rem, 5vw, 4rem); line-height: 1.05; letter-spacing: 0; }
      .lead { max-width: 760px; color: #52606d; line-height: 1.6; font-size: 1.1rem; }
      .toolbar { display: grid; grid-template-columns: 1fr 220px 180px; gap: 10px; margin: 28px 0; }
      input, select { border: 1px solid #cbd5cf; border-radius: 8px; padding: 12px; font-size: 1rem; background: white; }
      .count { color: #52606d; margin-bottom: 14px; }
      .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 14px; }
      .card { background: white; border: 1px solid #d8ded8; border-radius: 8px; padding: 18px; min-height: 190px; display: flex; flex-direction: column; gap: 10px; }
      .card h2 { margin: 0; font-size: 1.08rem; line-height: 1.35; }
      .card p { margin: 0; color: #52606d; line-height: 1.5; }
      .meta { display: flex; flex-wrap: wrap; gap: 6px; margin-top: auto; }
      .pill { border-radius: 999px; background: #e8eee9; color: #33433a; padding: 4px 8px; font-size: .8rem; }
      a { color: #176070; text-decoration-thickness: .08em; text-underline-offset: .18em; }
      @media (max-width: 760px) { .toolbar { grid-template-columns: 1fr; } }
    </style>
  </head>
  <body>
    <main>
      <h1>Zdroje pre učenie</h1>
      <p class="lead">
        Prvý import zo starej WordPress stránky. Zatiaľ jednoduchý katalóg, ale už bez databázy.
      </p>

      <div class="toolbar">
        <input id="search" type="search" placeholder="Hľadať podľa názvu alebo popisu..." />
        <select id="category">
          <option value="">Všetky kategórie</option>
          {kategorie.map((kategoria) => <option value={kategoria}>{kategoria}</option>)}
        </select>
        <select id="type">
          <option value="">Všetky typy</option>
          {typy.map((typ) => <option value={typ}>{typ}</option>)}
        </select>
      </div>

      <div class="count"><span id="count">{zdroje.length}</span> zdrojov</div>

      <section class="grid" id="grid">
        {zdroje.map((zdroj) => (
          <article class="card" data-title={zdroj.title.toLowerCase()} data-description={zdroj.description.toLowerCase()} data-category={zdroj.category} data-type={zdroj.type}>
            <h2><a href={zdroj.url}>{zdroj.title}</a></h2>
            <p>{zdroj.description || "Bez popisu."}</p>
            <div class="meta">
              {zdroj.category && <span class="pill">{zdroj.category}</span>}
              {zdroj.type && <span class="pill">{zdroj.type}</span>}
            </div>
          </article>
        ))}
      </section>
    </main>

    <script>
      const search = document.querySelector("#search");
      const category = document.querySelector("#category");
      const type = document.querySelector("#type");
      const cards = [...document.querySelectorAll(".card")];
      const count = document.querySelector("#count");

      function update() {
        const q = search.value.toLowerCase().trim();
        const c = category.value;
        const t = type.value;
        let visible = 0;

        for (const card of cards) {
          const textMatch = !q || card.dataset.title.includes(q) || card.dataset.description.includes(q);
          const categoryMatch = !c || card.dataset.category === c;
          const typeMatch = !t || card.dataset.type === t;
          const show = textMatch && categoryMatch && typeMatch;
          card.style.display = show ? "" : "none";
          if (show) visible++;
        }

        count.textContent = visible;
      }

      search.addEventListener("input", update);
      category.addEventListener("change", update);
      type.addEventListener("change", update);
    </script>
  </body>
</html>