---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import categoryTree from '../../data/categories.json';
import { catSlug } from '../../utils/catSlug';

// Počty počítame vždy naživo z aktuálneho obsahu (nie zo statického súboru),
// aby zohľadňovali zmazané/pridané námety cez CMS.
const allNamety = await getCollection('namety');
const leafCounts = new Map<string, number>();
for (const n of allNamety) {
  for (const c of n.data.categories) {
    leafCounts.set(c, (leafCounts.get(c) || 0) + 1);
  }
}

// Mená, ktoré už poznáme zo starej WordPress hierarchie (top-level aj podkategórie).
const knownNames = new Set<string>();
for (const top of categoryTree) {
  knownNames.add(top.name);
  for (const child of top.children) knownNames.add(child.name);
}

const knownCategories = categoryTree.map((top) => {
  const children = top.children
    .map((child) => ({ ...child, count: leafCounts.get(child.name) || 0 }))
    .filter((c) => c.count > 0)
    .sort((a, b) => b.count - a.count);
  const directCount = leafCounts.get(top.name) || 0;
  const childCount = children.reduce((sum, c) => sum + c.count, 0);
  return { ...top, count: directCount + childCount, children };
});

// Akékoľvek nové kategórie pridané cez CMS - zaradia sa do toho istého
// zoznamu ako ostatné, len bez podkategórií.
const newCategories = [...leafCounts.entries()]
  .filter(([name]) => !knownNames.has(name))
  .map(([name, count]) => ({ name, slug: catSlug(name), count, children: [] as { name: string; slug: string; count: number }[] }));

const categories = [...knownCategories, ...newCategories]
  .filter((c) => c.count > 0)
  .sort((a, b) => b.count - a.count);
---
<Layout title="Kategórie — Zavretá škola">
  <section class="chalk-texture bg-chalkboard text-chalk px-4 sm:px-6 py-14 text-center">
    <h1 class="font-display text-3xl sm:text-4xl font-semibold">Kategórie</h1>
    <p class="text-chalk/70 font-mono text-sm mt-2">{categories.length} kategórií podľa stupňa a predmetu</p>
  </section>
  <main class="max-w-5xl mx-auto px-4 py-12 space-y-8">
    {categories.map((cat) => (
      <div class="bg-white border border-ink/10 rounded-lg overflow-hidden">
        <a href={`/kategoria/${cat.slug}/`} class="flex justify-between items-center px-5 py-4 hover:bg-chalkboard/5 transition-colors">
          <span class="font-display font-semibold text-lg text-ink">{cat.name}</span>
          <span class="text-xs font-mono bg-chalkboard/5 text-ink/60 px-2 py-1 rounded">{cat.count}</span>
        </a>
        {cat.children.length > 0 && (
          <div class="border-t border-ink/10 px-5 py-3 flex flex-wrap gap-2">
            {cat.children.map((child) => (
              <a
                href={`/kategoria/${child.slug}/`}
                class="text-xs font-mono px-2.5 py-1 rounded-full bg-gridblue/10 text-gridblue hover:bg-gridblue/20"
              >
                {child.name} ({child.count})
              </a>
            ))}
          </div>
        )}
      </div>
    ))}
  </main>
</Layout>
