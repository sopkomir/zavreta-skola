---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import NametListing from '../../../components/NametListing.astro';
import Pagination from '../../../components/Pagination.astro';
import categoryTree from '../../../data/categories.json';
import { catSlug } from '../../../utils/catSlug';

export async function getStaticPaths({ paginate }) {
  const allNamety = await getCollection('namety');

  // Uzly zo starej WordPress hierarchie (hlavné aj podkategórie).
  const nodes: { slug: string; name: string; matchNames: string[] }[] = [];
  const knownNames = new Set<string>();
  for (const top of categoryTree) {
    knownNames.add(top.name);
    nodes.push({ slug: top.slug, name: top.name, matchNames: [top.name, ...top.children.map((c) => c.name)] });
    for (const child of top.children) {
      knownNames.add(child.name);
      nodes.push({ slug: child.slug, name: child.name, matchNames: [child.name] });
    }
  }

  // Akékoľvek ďalšie kategórie použité v obsahu (pridané cez CMS), ktoré ešte
  // nie sú súčasťou pôvodnej hierarchie - dostanú vlastnú, jednoduchú stránku.
  const usedNames = new Set<string>();
  for (const n of allNamety) {
    for (const c of n.data.categories) usedNames.add(c);
  }
  for (const name of usedNames) {
    if (!knownNames.has(name)) {
      nodes.push({ slug: catSlug(name), name, matchNames: [name] });
    }
  }

  return nodes.flatMap((node) => {
    const filtered = allNamety
      .filter((n) => n.data.categories.some((c) => node.matchNames.includes(c)))
      .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

    if (filtered.length === 0) return [];

    return paginate(filtered, {
      pageSize: 24,
      params: { category: node.slug },
      props: { categoryName: node.name },
    });
  });
}

const { page, categoryName } = Astro.props;
---
<Layout title={`${categoryName} — Zavretá škola`} description={`Učebné materiály, hry a videá v kategórii ${categoryName} na Zavretej škole.`}>
  <section class="chalk-texture bg-chalkboard text-chalk px-4 sm:px-6 py-14 text-center">
    <a href="/kategoria/" class="text-sm text-marker hover:underline font-mono">← všetky kategórie</a>
    <h1 class="font-display text-3xl sm:text-4xl font-semibold mt-3">{categoryName}</h1>
    <p class="text-chalk/70 font-mono text-sm mt-2">{page.total} námetov · strana {page.currentPage} / {page.lastPage}</p>
  </section>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <NametListing items={page.data} />
    <Pagination page={page} />
  </main>
</Layout>
