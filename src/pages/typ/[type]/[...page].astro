---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import NametCard from '../../../components/NametCard.astro';
import Pagination from '../../../components/Pagination.astro';
import { catSlug } from '../../../utils/catSlug';

export async function getStaticPaths({ paginate }) {
  const allNamety = await getCollection('namety');
  const types = [...new Set(allNamety.flatMap((n) => n.data.types))];

  return types.flatMap((type) => {
    const filtered = allNamety
      .filter((n) => n.data.types.includes(type))
      .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

    return paginate(filtered, {
      pageSize: 24,
      params: { type: catSlug(type) },
      props: { typeName: type },
    });
  });
}

const { page, typeName } = Astro.props;
---
<Layout title={`${typeName} — Zavretá škola`} description={`Učebné materiály typu ${typeName} na Zavretej škole.`}>
  <section class="chalk-texture bg-chalkboard text-chalk px-4 sm:px-6 py-14 text-center">
    <a href="/typ/" class="text-sm text-marker hover:underline font-mono">← všetky typy</a>
    <h1 class="font-display text-3xl sm:text-4xl font-semibold mt-3">{typeName}</h1>
    <p class="text-chalk/70 font-mono text-sm mt-2">{page.total} námetov · strana {page.currentPage} / {page.lastPage}</p>
  </section>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {page.data.map((namet, i) => <NametCard namet={namet} index={i} />)}
    </div>
    <Pagination page={page} />
  </main>
</Layout>