---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import NametListing from '../../components/NametListing.astro';
import NametCard from '../../components/NametCard.astro';

export async function getStaticPaths({ paginate }) {
  const allNamety = await getCollection('namety');
  const sorted = allNamety.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
  // Prvá strana žije na "/" (src/pages/index.astro), tu chceme len 2, 3, 4...
  return paginate(sorted, { pageSize: 24 }).filter((p) => p.params.page !== undefined);
}

const { page } = Astro.props;
---
<Layout title={`Zavretá škola — Strana ${page.currentPage}`}>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <a href="/" class="inline-flex items-center gap-1.5 px-3 py-1.5 mb-6 rounded-chip border-2 border-ink bg-white text-sm font-mono font-bold text-ink shadow-pop-sm transition-[transform,box-shadow] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-pop">
      ← na začiatok
    </a>
    <h1 class="font-display text-xl font-bold text-ink mb-6">Všetky námety — strana {page.currentPage}</h1>
    <NametListing items={page.data} />
    <nav class="mt-12 flex items-center justify-center gap-3 font-mono text-sm">
      <a href={page.currentPage === 2 ? '/' : page.url.prev} class="px-4 py-2 rounded-chip border-2 border-ink bg-white font-bold text-ink shadow-pop-sm transition-[transform,box-shadow] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-pop">
        ← predch.
      </a>
      <span class="text-ink/50 px-2">strana {page.currentPage} / {page.lastPage}</span>
      {page.url.next && (
        <a href={page.url.next} class="px-4 py-2 rounded-chip border-2 border-ink bg-marker font-bold text-ink shadow-pop-sm transition-[transform,box-shadow] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-pop">
          nasl. →
        </a>
      )}
    </nav>
  </main>
</Layout>
